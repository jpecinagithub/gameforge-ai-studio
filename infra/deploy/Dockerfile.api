# ---- build stage ----
FROM node:22-bookworm-slim AS build
WORKDIR /build
# Install workspace deps first (better layer caching)
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
RUN npm ci --no-audit --no-fund
# Build
COPY tsconfig.base.json ./
COPY packages/shared/ ./packages/shared/
COPY apps/api/ ./apps/api/
RUN npm run build --workspace=@gameforge/shared \
 && npm run build --workspace=gameforge-api

# ---- runtime stage ----
FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
# Non-root service user. The API never touches the Docker socket (see compose).
RUN useradd --uid 65532 --create-home --shell /usr/sbin/nologin app
WORKDIR /srv/app
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=build /build/packages/shared/dist ./packages/shared/dist
COPY --from=build /build/apps/api/dist ./apps/api/dist
# STORAGE_ROOT is bind-mounted at runtime (see docker-compose.yml)
RUN mkdir -p /var/lib/gameforge && chown app:app /var/lib/gameforge
USER 65532:65532
EXPOSE 8090
# Assumes apps/api package.json "main" is ./dist/index.js (Fastify bootstrap).
CMD ["node", "apps/api/dist/index.js"]
