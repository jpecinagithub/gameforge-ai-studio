# ---- build stage ----
FROM node:22-bookworm-slim AS build
WORKDIR /build
# npm ci needs EVERY workspace manifest (workspaces: apps/*, packages/*, plugins/*),
# even for workspaces this image never builds.
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/
COPY apps/runner/package.json ./apps/runner/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/model-providers/package.json ./packages/model-providers/
COPY packages/plugin-sdk/package.json ./packages/plugin-sdk/
COPY packages/agent-core/package.json ./packages/agent-core/
COPY packages/test-runner/package.json ./packages/test-runner/
COPY packages/game-templates/package.json ./packages/game-templates/
COPY plugins/procedural-geometry/package.json ./plugins/procedural-geometry/
COPY plugins/asset-thumbnail/package.json ./plugins/asset-thumbnail/
RUN npm ci --no-audit --no-fund
# Sources for this service's dependency closure (api: shared + model-providers + plugin-sdk).
COPY packages/shared/ ./packages/shared/
COPY packages/model-providers/ ./packages/model-providers/
COPY packages/plugin-sdk/ ./packages/plugin-sdk/
COPY apps/api/ ./apps/api/
# Internal packages must be built in dependency order: dependents resolve
# @gameforge/* through node_modules symlinks into each package's dist/.
RUN npm run build --workspace=@gameforge/shared \
 && npm run build --workspace=@gameforge/model-providers \
 && npm run build --workspace=@gameforge/plugin-sdk \
 && npm run build --workspace=gameforge-api

# ---- runtime stage ----
FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
# Non-root service user. The API never touches the Docker socket (see compose).
RUN useradd --uid 65532 --create-home --shell /usr/sbin/nologin app
WORKDIR /srv/app
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/
COPY apps/runner/package.json ./apps/runner/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/model-providers/package.json ./packages/model-providers/
COPY packages/plugin-sdk/package.json ./packages/plugin-sdk/
COPY packages/agent-core/package.json ./packages/agent-core/
COPY packages/test-runner/package.json ./packages/test-runner/
COPY packages/game-templates/package.json ./packages/game-templates/
COPY plugins/procedural-geometry/package.json ./plugins/procedural-geometry/
COPY plugins/asset-thumbnail/package.json ./plugins/asset-thumbnail/
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=build /build/packages/shared/dist ./packages/shared/dist
COPY --from=build /build/packages/model-providers/dist ./packages/model-providers/dist
COPY --from=build /build/packages/plugin-sdk/dist ./packages/plugin-sdk/dist
COPY --from=build /build/apps/api/dist ./apps/api/dist
# STORAGE_ROOT is bind-mounted at runtime (see docker-compose.yml)
RUN mkdir -p /var/lib/gameforge && chown app:app /var/lib/gameforge
USER 65532:65532
EXPOSE 8090
# Assumes apps/api package.json "main" is ./dist/index.js (Fastify bootstrap).
CMD ["node", "apps/api/dist/index.js"]
