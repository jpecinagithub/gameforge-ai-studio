# ---- build stage ----
FROM node:22-bookworm-slim AS build
WORKDIR /build
# npm ci needs EVERY workspace manifest (workspaces: apps/*, packages/*, plugins/*),
# even for workspaces this image never builds.
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/
COPY apps/runner/package.json ./apps/runner/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/model-providers/package.json ./packages/model-providers/
COPY packages/plugin-sdk/package.json ./packages/plugin-sdk/
COPY packages/agent-core/package.json ./packages/agent-core/
COPY packages/test-runner/package.json ./packages/test-runner/
COPY packages/game-templates/package.json ./packages/game-templates/
COPY plugins/procedural-geometry/package.json ./plugins/procedural-geometry/
COPY plugins/asset-thumbnail/package.json ./plugins/asset-thumbnail/
RUN npm ci --no-audit --no-fund
# Sources for this service's dependency closure
# (worker: shared + model-providers + plugin-sdk + agent-core + test-runner + gameforge-runner).
COPY packages/shared/ ./packages/shared/
COPY packages/model-providers/ ./packages/model-providers/
COPY packages/plugin-sdk/ ./packages/plugin-sdk/
COPY packages/agent-core/ ./packages/agent-core/
COPY packages/test-runner/ ./packages/test-runner/
COPY apps/runner/ ./apps/runner/
COPY apps/worker/ ./apps/worker/
# Internal packages must be built in dependency order: dependents resolve
# @gameforge/* through node_modules symlinks into each package's dist/.
RUN npm run build --workspace=@gameforge/shared \
 && npm run build --workspace=@gameforge/model-providers \
 && npm run build --workspace=@gameforge/plugin-sdk \
 && npm run build --workspace=@gameforge/agent-core \
 && npm run build --workspace=@gameforge/test-runner \
 && npm run build --workspace=gameforge-runner \
 && npm run build --workspace=gameforge-worker

# ---- runtime stage ----
FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
# Non-root service user. The worker never touches the Docker socket.
RUN useradd --uid 65532 --create-home --shell /usr/sbin/nologin app
WORKDIR /srv/app
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/worker/package.json ./apps/worker/
COPY apps/runner/package.json ./apps/runner/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/model-providers/package.json ./packages/model-providers/
COPY packages/plugin-sdk/package.json ./packages/plugin-sdk/
COPY packages/agent-core/package.json ./packages/agent-core/
COPY packages/test-runner/package.json ./packages/test-runner/
COPY packages/game-templates/package.json ./packages/game-templates/
COPY plugins/procedural-geometry/package.json ./plugins/procedural-geometry/
COPY plugins/asset-thumbnail/package.json ./plugins/asset-thumbnail/
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY --from=build /build/packages/shared/dist ./packages/shared/dist
COPY --from=build /build/packages/model-providers/dist ./packages/model-providers/dist
COPY --from=build /build/packages/plugin-sdk/dist ./packages/plugin-sdk/dist
COPY --from=build /build/packages/agent-core/dist ./packages/agent-core/dist
COPY --from=build /build/packages/test-runner/dist ./packages/test-runner/dist
COPY --from=build /build/apps/runner/dist ./apps/runner/dist
COPY --from=build /build/apps/worker/dist ./apps/worker/dist
RUN mkdir -p /var/lib/gameforge && chown app:app /var/lib/gameforge
# git is spawned at runtime (build checkouts). Install before dropping root.
RUN apt-get update && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*
USER 65532:65532
# No HTTP port: health is the BullMQ queue heartbeat, surfaced at
# GET /api/v1/system/metrics (see docs/ARCHITECTURE.md). No fake healthcheck.
CMD ["node", "apps/worker/dist/index.js"]
