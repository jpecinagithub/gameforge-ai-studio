# =====================================================================
# GameForge AI Studio — environment template
# Copy to .env and fill in. NEVER commit real values to git.
# =====================================================================

# --- Public surface ---------------------------------------------------
# Domain the studio is served from. Caddy provisions TLS via Let's Encrypt.
GF_DOMAIN=studio.example.com
# Email for ACME (certificate expiry notices).
GF_ACME_EMAIL=you@example.com
# Browser origins allowed to call the API (comma-separated, no trailing slash).
ALLOWED_ORIGINS=https://studio.example.com

# --- PostgreSQL --------------------------------------------------------
POSTGRES_USER=gameforge
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=gameforge
# Connection string the API/worker use (compose hostnames: postgres, redis).
# URL-encode the password if it contains special characters (openssl rand -hex is safe).
DATABASE_URL=postgres://gameforge:change-me-to-a-long-random-value@postgres:5432/gameforge

# --- Redis ---------------------------------------------------------------
# Private backend network only; no password by default. Set one if you ever
# expose Redis beyond the compose network.
# REDIS_PASSWORD=
REDIS_URL=redis://redis:6379

# --- Groq (SERVER-SIDE ONLY) ----------------------------------------------
# NEVER put this in client bundles, Vercel env vars, logs or exports.
# The API reads it at boot and registers it with the secret redactor.
GROQ_API_KEY=

# --- Storage ---------------------------------------------------------------
# Host directory bind-mounted into api/worker/runner. Created by scripts/init.sh
# with 0700. Holds: projects/ (git repos), blobs/ (content-addressed),
# artifacts/, backups/, work/ (runner workdirs), runner-logs/.
STORAGE_ROOT=/var/lib/gameforge

# --- Runner ------------------------------------------------------------------
RUNNER_WORK_ROOT=/var/lib/gameforge/work
RUNNER_LOG_ROOT=/var/lib/gameforge/runner-logs
# Docker CLI inside the runner container; override only for exotic setups.
# GF_DOCKER_BIN=docker
