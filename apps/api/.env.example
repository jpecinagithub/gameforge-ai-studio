# GameForge API — environment template. Copy to .env and fill in.
# NEVER commit a filled-in .env. No real secrets below — placeholders only.

# Postgres connection (API + worker). Example:
# DATABASE_URL=postgresql://gameforge:CHANGEME@127.0.0.1:5432/gameforge
DATABASE_URL=

# Redis connection (BullMQ). Example:
# REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=

# Groq API key — server-side only, never shipped to the browser.
# The API registers it with the secret redactor at boot; it is never returned
# by any endpoint (including /models/connection-test).
GROQ_API_KEY=

# Filesystem root for project git repos, blobs and artifacts.
STORAGE_ROOT=/var/lib/gameforge/storage

# Comma-separated list of allowed browser origins for CORS, e.g.
# ALLOWED_ORIGINS=https://studio.example.com
# Empty = no cross-origin browser access. '*' is refused in production.
ALLOWED_ORIGINS=

PORT=8090
# Bind address. Default 127.0.0.1 (reverse proxy terminates TLS).
# Set BIND_ADDR=0.0.0.0 only behind a firewall / private network.
BIND_ADDR=127.0.0.1

RATE_LIMIT_PER_MINUTE=100
LOG_LEVEL=info
NODE_ENV=production

# Optional override for the migrations directory.
# MIGRATIONS_DIR=/opt/gameforge/infra/db/migrations
